## Xtensa relocations as GNU as emits them, e.g. in the precompiled Espressif
## Wi-Fi libraries:
## - R_XTENSA_32 keeps its addend in the relocated word (partial_inplace) and
##   leaves r_addend 0; lld must add the word to S + A. A jump table of
##   section-relative entries collapses to the section base otherwise.
## - R_XTENSA_ASM_EXPAND and R_XTENSA_DIFF32 are relaxation markers: lld does
##   not relax, so there is nothing to apply and the bytes stay as they are.
## An LLVM-style R_XTENSA_32 (addend in r_addend, word 0) is checked beside them.
# REQUIRES: xtensa

# RUN: yaml2obj %s -o %t.o
# RUN: ld.lld %t.o --image-base=0 --section-start=.text=0x1000 --section-start=.rodata=0x2000 -o %t
# RUN: llvm-readelf -x .rodata -x .text %t | FileCheck %s

## The ASM_EXPAND target is not rewritten.
# CHECK:      Hex dump of section '.text':
# CHECK-NEXT: 0x00001000 3df03df0 3df03df0 3df03df0 3df03df0
## .text+0x10 and .text+0x24 in place, fn+4 by r_addend, the DIFF32 word untouched.
# CHECK:      Hex dump of section '.rodata':
# CHECK-NEXT: 0x00002000 10100000 24100000 08100000 2a000000

--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_XTENSA
Sections:
  - Name:         .text
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 4
    Content:      3df03df03df03df03df03df03df03df03df03df03df03df03df03df03df03df03df03df0
  - Name:         .rodata
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC ]
    AddressAlign: 4
    Content:      1000000024000000000000002a000000
  - Name: .rela.text
    Type: SHT_RELA
    Link: .symtab
    Info: .text
    Relocations:
      - Offset: 0x0
        Symbol: fn
        Type:   R_XTENSA_ASM_EXPAND
  - Name: .rela.rodata
    Type: SHT_RELA
    Link: .symtab
    Info: .rodata
    Relocations:
      - Offset: 0x0
        Symbol: .text
        Type:   R_XTENSA_32
      - Offset: 0x4
        Symbol: .text
        Type:   R_XTENSA_32
      - Offset: 0x8
        Symbol: fn
        Type:   R_XTENSA_32
        Addend: 4
      - Offset: 0xc
        Symbol: fn
        Type:   R_XTENSA_DIFF32
Symbols:
  - Name:    .text
    Type:    STT_SECTION
    Section: .text
  - Name:    _start
    Section: .text
    Binding: STB_GLOBAL
  - Name:    fn
    Section: .text
    Value:   0x4
    Binding: STB_GLOBAL
